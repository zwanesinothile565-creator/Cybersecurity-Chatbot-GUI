<Window x:Class="CyberSecurityBotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="700"
        Width="1000"
        Background="#0F172A"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- LEFT MENU -->
        <Border Background="#111827"
                Width="250"
                HorizontalAlignment="Left">

            <StackPanel Margin="15">

                <!-- LOGO -->
                <TextBlock Text="🛡"
                           FontSize="60"
                           HorizontalAlignment="Center"
                           Margin="0,10"/>

                <!-- TITLE -->
                <TextBlock Text="Cyber Security Bot"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,10"/>

                <!-- USER -->
                <Border Background="#1E293B"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,20,0,20">

                    <StackPanel>

                        <TextBlock Text="Current User"
                                   Foreground="#94A3B8"
                                   FontSize="14"/>

                        <TextBlock x:Name="txtUserDisplay"
                                   Text="Guest"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- MENU LABEL -->
                <TextBlock Text="TOPICS"
                           Foreground="#38BDF8"
                           FontWeight="Bold"
                           Margin="0,10"/>

                <!-- PASSWORD -->
                <Button x:Name="btnPassword"
                        Content="🔑 Password Safety"
                        Height="45"
                        Margin="0,10"
                        Background="#2563EB"
                        Foreground="White"
                        FontSize="16"
                        BorderThickness="0"
                        Click="btnPassword_Click"/>

                <!-- PHISHING -->
                <Button x:Name="btnPhishing"
                        Content="🎣 Phishing"
                        Height="45"
                        Margin="0,10"
                        Background="#DC2626"
                        Foreground="White"
                        FontSize="16"
                        BorderThickness="0"
                        Click="btnPhishing_Click"/>

                <!-- PRIVACY -->
                <Button x:Name="btnPrivacy"
                        Content="🔒 Privacy"
                        Height="45"
                        Margin="0,10"
                        Background="#7C3AED"
                        Foreground="White"
                        FontSize="16"
                        BorderThickness="0"
                        Click="btnPrivacy_Click"/>

                <!-- SAFE BROWSING -->
                <Button x:Name="btnBrowsing"
                        Content="🌐 Safe Browsing"
                        Height="45"
                        Margin="0,10"
                        Background="#059669"
                        Foreground="White"
                        FontSize="16"
                        BorderThickness="0"
                        Click="btnBrowsing_Click"/>

                <!-- MALWARE -->
                <Button x:Name="btnMalware"
                        Content="💀 Malware"
                        Height="45"
                        Margin="0,10"
                        Background="#EA580C"
                        Foreground="White"
                        FontSize="16"
                        BorderThickness="0"
                        Click="btnMalware_Click"/>

            </StackPanel>
        </Border>

        <!-- MAIN AREA -->
        <Grid Margin="270,20,20,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Background="#1E293B"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,0,0,20">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="🤖"
                               FontSize="40"
                               Margin="0,0,10,0"/>

                    <StackPanel>

                        <TextBlock Text="Cybersecurity Awareness Assistant"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Learn how to stay safe online"
                                   Foreground="#CBD5E1"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- CHAT AREA -->
            <Border Grid.Row="1"
                    Background="#1E293B"
                    CornerRadius="12"
                    Padding="10">

                <RichTextBox x:Name="ChatBox"
                             Background="#1E293B"
                             Foreground="White"
                             BorderThickness="0"
                             FontSize="16"
                             VerticalScrollBarVisibility="Auto"/>
            </Border>

            <!-- INPUT -->
            <Border Grid.Row="2"
                    Background="#1E293B"
                    CornerRadius="12"
                    Padding="10"
                    Margin="0,20,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <!-- USER INPUT -->
                    <TextBox x:Name="txtUserInput"
                             FontSize="16"
                             Height="40"
                             Background="#334155"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="10"
                             VerticalContentAlignment="Center"/>

                    <!-- SEND -->
                    <Button x:Name="btnSend"
                            Grid.Column="1"
                            Content="Send ➜"
                            Margin="10,0,0,0"
                            Background="#2563EB"
                            Foreground="White"
                            FontSize="16"
                            BorderThickness="0"
                            Click="btnSend_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>
</Window>